    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0065","fieldKey":"title"} -->
    <Title>About a dot, considered at length</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0065","fieldKey":"date"} -->
    <Date>2020-06-10</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0065","fieldKey":"description"} -->
    <Description>Bartholomew Søndergaard talks about the long argument with the colour blue. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
