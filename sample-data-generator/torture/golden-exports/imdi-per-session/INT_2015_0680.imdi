    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0680","fieldKey":"title"} -->
    <Title>On why the frame is the real work</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0680","fieldKey":"date"} -->
