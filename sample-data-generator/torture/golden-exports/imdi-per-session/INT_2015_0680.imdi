    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0680","fieldKey":"description"} -->
    <Description>Jules Achterberg talks about drawing with a ladder. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
