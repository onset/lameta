    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0028","fieldKey":"title"} -->
    <Title>About a dot, considered at length</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0028","fieldKey":"date"} -->
    <Date>2023-05-01</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0028","fieldKey":"description"} -->
    <Description>Dmitri Vasquez talks about the politics of the colour orange. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
