    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0015","fieldKey":"description"} -->
    <Description>Vũ Nakamura talks about negative space and its landlord. The interview stopped twice because the artist wanted to look at the corner of the room.</Description>
