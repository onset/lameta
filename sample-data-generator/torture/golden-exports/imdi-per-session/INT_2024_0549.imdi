    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0549","fieldKey":"title"} -->
    <Title>On listening to grey</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0549","fieldKey":"date"} -->
    <Date>2024-10-18</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0549","fieldKey":"description"} -->
    <Description>Saoirse Mbeki talks about a portrait of the wind, from behind. The artist answered every question with a question, and then with a long pause, which the transcript renders as "…".</Description>
