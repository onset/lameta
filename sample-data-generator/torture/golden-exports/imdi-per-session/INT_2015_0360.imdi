    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0360","fieldKey":"title"} -->
    <Title>About the moment before the first mark</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0360","fieldKey":"date"} -->
    <Date>2015-01-25</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0360","fieldKey":"description"} -->
    <Description>Zofia O'Shaughnessy talks about eleven shades of white and one impostor. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
