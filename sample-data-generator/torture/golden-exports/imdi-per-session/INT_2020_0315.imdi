    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0315","fieldKey":"description"} -->
    <Description>Greta Kowalczyk talks about the installation that was mistaken for scaffolding. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
