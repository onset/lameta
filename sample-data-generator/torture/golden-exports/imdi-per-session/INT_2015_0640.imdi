    <Name>INT_2015_0640</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0640","fieldKey":"title"} -->
    <Title>On the shadow of a canvas that was never painted</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0640","fieldKey":"date"} -->
    <Date>2015-05-25</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0640","fieldKey":"description"} -->
    <Description>Agnès Ikeda talks about the moment before the first mark. The artist insists the recording itself is the artwork and that we are now co-authors.</Description>
