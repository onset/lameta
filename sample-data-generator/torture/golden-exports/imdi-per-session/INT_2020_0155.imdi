    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0155","fieldKey":"title"} -->
    <Title>About a dot, considered at length</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0155","fieldKey":"date"} -->
    <Date>2020-12-16</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0155","fieldKey":"description"} -->
    <Description>Lucía Dubois-Ngata talks about the politics of the colour orange. Halfway through, a visitor asked whether the work was finished. It was not clear that the question had an answer.</Description>
