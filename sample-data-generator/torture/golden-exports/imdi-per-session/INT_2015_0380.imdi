    <Name>INT_2015_0380</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0380","fieldKey":"title"} -->
    <Title>Notes on the third side of a line</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0380","fieldKey":"date"} -->
    <Date>2015-09-17</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0380","fieldKey":"description"} -->
    <Description>Malak O'Shaughnessy talks about the politics of the colour orange. There is a long passage about a single brush, which the artist calls "the elder".</Description>
