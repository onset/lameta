    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0240","fieldKey":"title"} -->
    <Title>Beyond a square that refuses to be a square</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0240","fieldKey":"date"} -->
    <Date>2015-01-17</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0240","fieldKey":"description"} -->
    <Description>Rangi Blanc talks about painting the colour of a Tuesday. The artist insists the recording itself is the artwork and that we are now co-authors.</Description>
