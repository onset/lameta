    <!-- lameta-source {"folderType":"session","folderId":"ELAR_rule_triggers","fieldKey":"title"} -->
    <Title>Lullaby for a primed canvas</Title>
    <!-- lameta-source {"folderType":"session","folderId":"ELAR_rule_triggers","fieldKey":"date"} -->
    <Date>2024-10-01</Date>
    <!-- lameta-source {"folderType":"session","folderId":"ELAR_rule_triggers","fieldKey":"description"} -->
    <Description>The artist talks about silence, in three coats of varnish. Recorded while the artist repainted the studio wall the same white, four times.</Description>
