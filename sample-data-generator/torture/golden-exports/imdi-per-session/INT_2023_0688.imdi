    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0688","fieldKey":"title"} -->
    <Title>About the brushstroke that got away</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0688","fieldKey":"date"} -->
    <Date>2023-05-17</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0688","fieldKey":"description"} -->
    <Description>Quilla Dubois-Ngata talks about listening to grey. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
