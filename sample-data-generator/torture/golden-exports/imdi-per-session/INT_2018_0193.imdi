    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0193","fieldKey":"title"} -->
    <Title>On the shadow of a canvas that was never painted</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0193","fieldKey":"date"} -->
    <Date>2018-02-26</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0193","fieldKey":"description"} -->
    <Description>Farhad Haddad talks about the moment before the first mark. Recorded while the artist repainted the studio wall the same white, four times.</Description>
