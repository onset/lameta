    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0406","fieldKey":"title"} -->
    <Title>About the moment before the first mark</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0406","fieldKey":"date"} -->
    <Date>2021-11-15</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0406","fieldKey":"description"} -->
    <Description>Oona Lindqvist talks about eleven shades of white and one impostor. Halfway through, a visitor asked whether the work was finished. It was not clear that the question had an answer.</Description>
