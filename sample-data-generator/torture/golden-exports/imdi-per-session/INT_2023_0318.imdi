    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0318","fieldKey":"description"} -->
    <Description>Farhad Zielińska talks about a sculpture made entirely of hesitation. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
