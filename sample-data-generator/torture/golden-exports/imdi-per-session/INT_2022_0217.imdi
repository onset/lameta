    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0217","fieldKey":"description"} -->
    <Description>Piotr Quispe talks about a portrait of the wind, from behind. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
