    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0632","fieldKey":"description"} -->
    <Description>Vũ Ikeda talks about listening to grey. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
