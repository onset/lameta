    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0084","fieldKey":"title"} -->
    <Title>Beyond an exhibition in total darkness</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0084","fieldKey":"date"} -->
