    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0210","fieldKey":"title"} -->
    <Title>Notes on triangles as a form of apology</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0210","fieldKey":"date"} -->
    <Date>2015-07-15</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0210","fieldKey":"description"} -->
    <Description>Xochitl Lindqvist talks about a sculpture made entirely of hesitation. Halfway through, a visitor asked whether the work was finished. It was not clear that the question had an answer.</Description>
