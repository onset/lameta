    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0288","fieldKey":"title"} -->
    <Title>Towards how to hang a painting upside down on purpose</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0288","fieldKey":"date"} -->
    <Date>2023-01-09</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0288","fieldKey":"description"} -->
    <Description>Rangi Haddad talks about the long argument with the colour blue. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
