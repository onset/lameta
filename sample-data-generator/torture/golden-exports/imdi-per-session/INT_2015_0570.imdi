    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0570","fieldKey":"description"} -->
    <Description>Farhad Zielińska talks about the emotional weight of beige. The interview stopped twice because the artist wanted to look at the corner of the room.</Description>
