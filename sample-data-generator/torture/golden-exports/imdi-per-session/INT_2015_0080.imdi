    <Name>INT_2015_0080</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0080","fieldKey":"title"} -->
    <Title>Against what the gallery cleaner threw away</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0080","fieldKey":"date"} -->
    <Date>2015-09-25</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0080","fieldKey":"description"} -->
    <Description>Rangi Nakamura talks about the emotional weight of beige. The artist answered every question with a question, and then with a long pause, which the transcript renders as "…".</Description>
