    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0569","fieldKey":"title"} -->
    <Title>On the shadow of a canvas that was never painted</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0569","fieldKey":"date"} -->
    <Date>2024-06-10</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0569","fieldKey":"description"} -->
    <Description>Ásdís Søndergaard talks about triangles as a form of apology. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
