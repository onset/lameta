    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0433","fieldKey":"description"} -->
    <Description>Lucía Kowalczyk talks about the shadow of a canvas that was never painted. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
