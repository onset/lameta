    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0712","fieldKey":"description"} -->
    <Description>Dmitri Whitehorse talks about the emotional weight of beige. Recorded while the artist repainted the studio wall the same white, four times.</Description>
