    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0053","fieldKey":"title"} -->
    <Title>About a dot, considered at length</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0053","fieldKey":"date"} -->
    <Date>2018-06-26</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0053","fieldKey":"description"} -->
    <Description>Dmitri Quispe talks about the long argument with the colour blue. There is a long passage about a single brush, which the artist calls "the elder".</Description>
