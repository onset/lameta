    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0592","fieldKey":"title"} -->
    <Title>On why the frame is the real work</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0592","fieldKey":"date"} -->
