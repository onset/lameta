    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0301","fieldKey":"title"} -->
    <Title>About the brushstroke that got away</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0301","fieldKey":"date"} -->
    <Date>2016-02-22</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0301","fieldKey":"description"} -->
    <Description>Ulla O'Shaughnessy talks about an exhibition in total darkness. There is a long passage about a single brush, which the artist calls "the elder".</Description>
