    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0375","fieldKey":"title"} -->
    <Title>About a dot, considered at length</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0375","fieldKey":"date"} -->
    <Date>2020-04-12</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0375","fieldKey":"description"} -->
    <Description>Ếlodie Ikeda talks about the politics of the colour orange. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
