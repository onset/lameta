    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0310","fieldKey":"title"} -->
    <Title>Against what the gallery cleaner threw away</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0310","fieldKey":"date"} -->
    <Date>2015-11-03</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0310","fieldKey":"description"} -->
    <Description>Ásdís Nakamura talks about the emotional weight of beige. The artist answered every question with a question, and then with a long pause, which the transcript renders as "…".</Description>
