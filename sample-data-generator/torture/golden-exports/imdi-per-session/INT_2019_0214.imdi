    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0214","fieldKey":"title"} -->
    <Title>Notes on triangles as a form of apology</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0214","fieldKey":"date"} -->
    <Date>2019-11-19</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0214","fieldKey":"description"} -->
    <Description>Zofia Ulloa talks about a sculpture made entirely of hesitation. Halfway through, a visitor asked whether the work was finished. It was not clear that the question had an answer.</Description>
