    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0020","fieldKey":"title"} -->
    <Title>Against the installation that was mistaken for scaffolding</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0020","fieldKey":"date"} -->
    <Date>2015-09-21</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0020","fieldKey":"description"} -->
    <Description>Jules Haddad talks about silence, in three coats of varnish. The interview stopped twice because the artist wanted to look at the corner of the room.</Description>
