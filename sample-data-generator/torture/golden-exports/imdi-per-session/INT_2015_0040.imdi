    <Name>INT_2015_0040</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0040","fieldKey":"title"} -->
    <Title>On why the canvas must stay blank</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0040","fieldKey":"date"} -->
    <Date>2015-05-13</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0040","fieldKey":"description"} -->
    <Description>Xochitl Rautenbach talks about the third side of a line. The artist insists the recording itself is the artwork and that we are now co-authors.</Description>
