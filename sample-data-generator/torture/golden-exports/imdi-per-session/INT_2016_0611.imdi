    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0611","fieldKey":"title"} -->
    <Title>About painting the colour of a Tuesday</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0611","fieldKey":"date"} -->
