    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0613","fieldKey":"description"} -->
    <Description>Chiamaka Quispe talks about the shadow of a canvas that was never painted. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
