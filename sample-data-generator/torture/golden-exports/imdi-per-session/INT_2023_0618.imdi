    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0618","fieldKey":"description"} -->
    <Description>Ulla Vasquez talks about how to hang a painting upside down on purpose. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
