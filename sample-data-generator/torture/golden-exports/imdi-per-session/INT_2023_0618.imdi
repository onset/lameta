    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0618","fieldKey":"title"} -->
    <Title>On why the canvas must stay blank</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0618","fieldKey":"date"} -->
