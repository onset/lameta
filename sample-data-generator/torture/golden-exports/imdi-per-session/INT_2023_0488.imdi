    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0488","fieldKey":"description"} -->
    <Description>Oona Fontaine talks about a sculpture made entirely of hesitation. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
