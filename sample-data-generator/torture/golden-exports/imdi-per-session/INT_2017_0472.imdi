    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0472","fieldKey":"title"} -->
    <Title>Notes on triangles as a form of apology</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0472","fieldKey":"date"} -->
