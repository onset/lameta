    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0750","fieldKey":"title"} -->
    <Title>On listening to grey</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0750","fieldKey":"date"} -->
    <Date>2015-07-23</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0750","fieldKey":"description"} -->
    <Description>Nnamdi Tanaka talks about a portrait of the wind, from behind. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
