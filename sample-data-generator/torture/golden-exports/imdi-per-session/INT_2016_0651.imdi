    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0651","fieldKey":"title"} -->
    <Title>About the moment before the first mark</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0651","fieldKey":"date"} -->
    <Date>2016-04-08</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0651","fieldKey":"description"} -->
    <Description>Agnès O'Shaughnessy talks about the shadow of a canvas that was never painted. Halfway through, a visitor asked whether the work was finished. It was not clear that the question had an answer.</Description>
