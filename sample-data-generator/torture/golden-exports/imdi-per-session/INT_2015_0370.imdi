    <Name>INT_2015_0370</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0370","fieldKey":"title"} -->
    <Title>Beyond a sculpture made entirely of hesitation</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0370","fieldKey":"date"} -->
    <Date>2015-11-07</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0370","fieldKey":"description"} -->
    <Description>Bartholomew Achterberg talks about triangles as a form of apology. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
