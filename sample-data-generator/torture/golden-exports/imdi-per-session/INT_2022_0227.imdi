    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0227","fieldKey":"description"} -->
    <Description>Rangi Blanc talks about a sculpture made entirely of hesitation. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
