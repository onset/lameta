    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0303","fieldKey":"description"} -->
    <Description>Quilla Pereira talks about listening to grey. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
