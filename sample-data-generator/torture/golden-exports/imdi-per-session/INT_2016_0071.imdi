    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0071","fieldKey":"title"} -->
    <Title>Notes on silence, in three coats of varnish</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0071","fieldKey":"date"} -->
    <Date>2016-12-16</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0071","fieldKey":"description"} -->
    <Description>Piotr Rautenbach talks about the installation that was mistaken for scaffolding. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
