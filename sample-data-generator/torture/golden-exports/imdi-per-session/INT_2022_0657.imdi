    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0657","fieldKey":"title"} -->
    <Title>Against what the gallery cleaner threw away</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0657","fieldKey":"date"} -->
    <Date>2022-10-14</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0657","fieldKey":"description"} -->
    <Description>Chiamaka Eriksdóttir talks about the emotional weight of beige. The artist insists the recording itself is the artwork and that we are now co-authors.</Description>
