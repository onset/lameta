    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0792","fieldKey":"description"} -->
    <Description>Farhad Nakamura talks about a portrait of the wind, from behind. The interview stopped twice because the artist wanted to look at the corner of the room.</Description>
