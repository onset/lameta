    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0776","fieldKey":"title"} -->
    <Title>Notes on the third side of a line</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0776","fieldKey":"date"} -->
    <Date>2021-09-21</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0776","fieldKey":"description"} -->
    <Description>Ŋozi Zielińska talks about the politics of the colour orange. There is a long passage about a single brush, which the artist calls "the elder".</Description>
