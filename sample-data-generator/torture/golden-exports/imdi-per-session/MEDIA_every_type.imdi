    <!-- lameta-source {"folderType":"session","folderId":"MEDIA_every_type","fieldKey":"title"} -->
    <Title>The archive of every format the artist ever used</Title>
    <!-- lameta-source {"folderType":"session","folderId":"MEDIA_every_type","fieldKey":"date"} -->
    <Date>2024-08-01</Date>
    <!-- lameta-source {"folderType":"session","folderId":"MEDIA_every_type","fieldKey":"description"} -->
    <Description>The artist talks about the brushstroke that got away. Recorded while the artist repainted the studio wall the same white, four times.</Description>
    <MDGroup>
