    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0710","fieldKey":"description"} -->
    <Description>Vũ Tanaka talks about a dot, considered at length. The interview stopped twice because the artist wanted to look at the corner of the room.</Description>
