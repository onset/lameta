    <!-- lameta-source {"folderType":"session","folderId":"INT_2020_0075","fieldKey":"description"} -->
    <Description>Hiroshi Kowalczyk talks about a dot, considered at length. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
