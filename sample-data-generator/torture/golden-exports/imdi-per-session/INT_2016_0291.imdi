    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0291","fieldKey":"description"} -->
    <Description>Ingrid Vasquez talks about the shadow of a canvas that was never painted. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
