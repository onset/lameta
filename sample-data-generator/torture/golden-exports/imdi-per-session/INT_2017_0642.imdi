    <Name>INT_2017_0642</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0642","fieldKey":"title"} -->
    <Title>On the shadow of a canvas that was never painted</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0642","fieldKey":"date"} -->
    <Date>2017-07-27</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0642","fieldKey":"description"} -->
    <Description>Tenzin Rautenbach talks about the moment before the first mark. The artist answered every question with a question, and then with a long pause, which the transcript renders as "…".</Description>
