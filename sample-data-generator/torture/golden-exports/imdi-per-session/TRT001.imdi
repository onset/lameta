    <!-- lameta-source {"folderType":"session","folderId":"TRT001","fieldKey":"title"} -->
    <Title LanguageId="ISO639-3:eng">On painting the colour of a Tuesday</Title>
    <!-- lameta-source {"folderType":"session","folderId":"TRT001","fieldKey":"title"} -->
    <Title LanguageId="ISO639-3:spa">Sobre pintar el color de un martes</Title>
    <!-- lameta-source {"folderType":"session","folderId":"TRT001","fieldKey":"date"} -->
    <Date>2024-01-15</Date>
    <!-- lameta-source {"folderType":"session","folderId":"TRT001","fieldKey":"description"} -->
    <Description LanguageId="ISO639-3:eng">Nɔkɔ Ɛsi explains why Tuesday is a warmer grey than Monday.</Description>
    <!-- lameta-source {"folderType":"session","folderId":"TRT001","fieldKey":"description"} -->
    <Description LanguageId="ISO639-3:spa">Nɔkɔ Ɛsi explica por qué el martes es un gris más cálido que el lunes.</Description>
