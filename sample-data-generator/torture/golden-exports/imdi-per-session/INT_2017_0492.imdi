    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0492","fieldKey":"title"} -->
    <Title>About a dot, considered at length</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0492","fieldKey":"date"} -->
    <Date>2017-01-17</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0492","fieldKey":"description"} -->
    <Description>Ếlodie Blanc talks about the long argument with the colour blue. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
