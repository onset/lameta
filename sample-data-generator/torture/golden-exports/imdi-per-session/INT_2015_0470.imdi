    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0470","fieldKey":"title"} -->
    <Title>About painting the colour of a Tuesday</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0470","fieldKey":"date"} -->
    <Date>2015-03-23</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0470","fieldKey":"description"} -->
    <Description>Dmitri Kowalczyk talks about why the frame is the real work. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
