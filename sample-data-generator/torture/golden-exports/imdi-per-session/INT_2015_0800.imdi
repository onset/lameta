    <Name>INT_2015_0800</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0800","fieldKey":"title"} -->
    <Title>Beyond an exhibition in total darkness</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0800","fieldKey":"date"} -->
    <Date>2015-09-17</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0800","fieldKey":"description"} -->
    <Description>Quilla Dubois-Ngata talks about the brushstroke that got away. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
