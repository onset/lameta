    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0104","fieldKey":"title"} -->
    <Title>About painting the colour of a Tuesday</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0104","fieldKey":"date"} -->
    <Date>2019-09-21</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0104","fieldKey":"description"} -->
    <Description>Ulla Ikeda talks about why the frame is the real work. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
