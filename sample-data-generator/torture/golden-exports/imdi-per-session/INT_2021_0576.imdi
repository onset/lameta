    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0576","fieldKey":"title"} -->
    <Title>About the moment before the first mark</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0576","fieldKey":"date"} -->
    <Date>2021-01-17</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0576","fieldKey":"description"} -->
    <Description>Ếlodie Ulloa talks about the shadow of a canvas that was never painted. There is a long passage about a single brush, which the artist calls "the elder".</Description>
