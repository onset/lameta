    <Name>INT_2017_0572</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0572","fieldKey":"title"} -->
    <Title>On why the canvas must stay blank</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0572","fieldKey":"date"} -->
    <Date>2017-09-13</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2017_0572","fieldKey":"description"} -->
    <Description>Ásdís Mbeki talks about the third side of a line. The artist insists the recording itself is the artwork and that we are now co-authors.</Description>
