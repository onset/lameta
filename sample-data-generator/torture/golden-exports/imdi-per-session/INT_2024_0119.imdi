    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0119","fieldKey":"title"} -->
    <Title>About the brushstroke that got away</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0119","fieldKey":"date"} -->
    <Date>2024-12-08</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2024_0119","fieldKey":"description"} -->
    <Description>Ŋozi Fontaine talks about listening to grey. There is a long passage about a single brush, which the artist calls "the elder".</Description>
