    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0703","fieldKey":"description"} -->
    <Description>Dmitri Whitehorse talks about the politics of the colour orange. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
