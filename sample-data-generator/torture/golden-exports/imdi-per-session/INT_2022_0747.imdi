    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0747","fieldKey":"title"} -->
    <Title>Beyond a sculpture made entirely of hesitation</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0747","fieldKey":"date"} -->
