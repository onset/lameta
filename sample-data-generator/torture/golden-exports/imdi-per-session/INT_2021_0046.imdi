    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0046","fieldKey":"title"} -->
    <Title>Towards negative space and its landlord</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0046","fieldKey":"date"} -->
    <Date>2021-11-19</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2021_0046","fieldKey":"description"} -->
    <Description>Lucía Jovanović talks about eleven shades of white and one impostor. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
