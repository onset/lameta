    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0458","fieldKey":"title"} -->
    <Title>Beyond a square that refuses to be a square</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0458","fieldKey":"date"} -->
    <Date>2023-03-11</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0458","fieldKey":"description"} -->
    <Description>Greta Lindqvist talks about painting the colour of a Tuesday. The artist answered every question with a question, and then with a long pause, which the transcript renders as "…".</Description>
