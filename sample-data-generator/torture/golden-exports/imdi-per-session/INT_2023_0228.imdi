    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0228","fieldKey":"description"} -->
    <Description>Xochitl Fontaine talks about why the frame is the real work. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
