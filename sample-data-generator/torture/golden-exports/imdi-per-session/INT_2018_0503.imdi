    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0503","fieldKey":"title"} -->
    <Title>Notes on silence, in three coats of varnish</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2018_0503","fieldKey":"date"} -->
