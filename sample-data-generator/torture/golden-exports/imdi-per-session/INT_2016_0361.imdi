    <!-- lameta-source {"folderType":"session","folderId":"INT_2016_0361","fieldKey":"description"} -->
    <Description>Farhad Zielińska talks about the shadow of a canvas that was never painted. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
