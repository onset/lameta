    <Name>INT_2019_0744</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0744","fieldKey":"title"} -->
    <Title>About a dot, considered at length</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0744","fieldKey":"date"} -->
    <Date>2019-01-17</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0744","fieldKey":"description"} -->
    <Description>Zofia Nakamura talks about the politics of the colour orange. There is a long passage about a single brush, which the artist calls "the elder".</Description>
