    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0760","fieldKey":"title"} -->
    <Title>About painting the colour of a Tuesday</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0760","fieldKey":"date"} -->
    <Date>2015-05-05</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0760","fieldKey":"description"} -->
    <Description>Farhad Tanaka talks about a square that refuses to be a square. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
