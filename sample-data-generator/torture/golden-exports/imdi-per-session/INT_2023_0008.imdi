    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0008","fieldKey":"title"} -->
    <Title>About painting the colour of a Tuesday</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0008","fieldKey":"date"} -->
    <Date>2023-09-09</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2023_0008","fieldKey":"description"} -->
    <Description>Ŋozi Yılmaz talks about a square that refuses to be a square. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
