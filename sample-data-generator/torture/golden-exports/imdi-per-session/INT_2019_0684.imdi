    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0684","fieldKey":"title"} -->
    <Title>On why the frame is the real work</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0684","fieldKey":"date"} -->
