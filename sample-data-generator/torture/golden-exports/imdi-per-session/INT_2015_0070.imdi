    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0070","fieldKey":"title"} -->
    <Title>Notes on triangles as a form of apology</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0070","fieldKey":"date"} -->
    <Date>2015-11-15</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0070","fieldKey":"description"} -->
    <Description>Wanjiru Gómez talks about a sculpture made entirely of hesitation. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
