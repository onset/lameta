    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0410","fieldKey":"title"} -->
    <Title>About the brushstroke that got away</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0410","fieldKey":"date"} -->
    <Date>2015-03-19</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0410","fieldKey":"description"} -->
    <Description>Agnès O'Shaughnessy talks about listening to grey. Halfway through, a visitor asked whether the work was finished. It was not clear that the question had an answer.</Description>
