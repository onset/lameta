    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0714","fieldKey":"title"} -->
    <Title>Beyond the long argument with the colour blue</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2019_0714","fieldKey":"date"} -->
