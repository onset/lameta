    <Name>INT_2022_0417</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0417","fieldKey":"title"} -->
    <Title>On the shadow of a canvas that was never painted</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0417","fieldKey":"date"} -->
    <Date>2022-10-26</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2022_0417","fieldKey":"description"} -->
    <Description>Ulla Castellanos talks about triangles as a form of apology. The artist brought a canvas, unwrapped it, looked at it, and wrapped it again.</Description>
