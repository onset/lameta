    <Name>INT_2015_0100</Name>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0100","fieldKey":"title"} -->
    <Title>Notes on silence, in three coats of varnish</Title>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0100","fieldKey":"date"} -->
    <Date>2015-05-17</Date>
    <!-- lameta-source {"folderType":"session","folderId":"INT_2015_0100","fieldKey":"description"} -->
    <Description>Farhad Achterberg talks about a square that refuses to be a square. A curator joined for ten minutes and left convinced that the chair was part of the exhibition.</Description>
    <MDGroup>
