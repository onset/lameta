      <Session>
        <Name>_Leading_Space</Name>
        <Title>Towards a portrait of the wind, from behind</Title>
        <Date>2024-05-01</Date>
        <Description>The artist talks about listening to grey. The artist asked that the microphone face away from the painting, so as not to influence it.</Description>
        <MDGroup>
          <Location>
            <Continent Link="http://www.mpi.nl/IMDI/Schema/Continents.xml" Type="ClosedVocabulary">Oceania</Continent>
