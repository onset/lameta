      <Session>
        <Name>ConsentDocuments</Name>
        <Title>Documentation of consent for the contributors to this collection</Title>
        <Date>(export date)</Date>
        <Description>This bundle contains media demonstrating informed consent for sessions in this collection.</Description>
        <MDGroup>
          <Location>
            <Continent Link="http://www.mpi.nl/IMDI/Schema/Continents.xml" Type="ClosedVocabulary">Oceania</Continent>
