{
  "typescript.tsdk": "./node_modules/typescript/lib",
  "editor.formatOnSave": true,
  "typescript.format.enable": false,
  "javascript.format.enable": false,
  "cSpell.words": [
    "Dropzone",
    "ELAR",
    "electron",
    "Heole",
    "Huli",
    "lameta",
    "lingmetax",
    "omitexport",
    "Paradisec",
    "Pardesic",
    "playwright",
    "scripthost"
  ],
  "cSpell.diagnosticLevel": "Hint",
  "wallaby.alwaysOpenLocalWallabyAppUrl": true,
  "wallaby.codeLensFeature.runTest": true,
  "testing.automaticallyOpenPeekView": "never",
  "terminal.integrated.env.windows": {
    "TMP": "${env:LOCALAPPDATA}\\Temp",
    "TEMP": "${env:LOCALAPPDATA}\\Temp",
    "TMPDIR": "${env:LOCALAPPDATA}\\Temp"
  },
  "workbench.colorCustomizations": {
    "statusBar.background": "#e69664",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#df7838",
    "statusBarItem.remoteBackground": "#e69664",
    "statusBarItem.remoteForeground": "#15202b"
  },
  "peacock.color": "#e69664"
}