{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Run vitest tests",
      "command": "pnpm",
      "args": ["run", "test", "--", "--run"],
      "options": {
        "env": {
          "TMP": "${env:LOCALAPPDATA}\\Temp",
          "TEMP": "${env:LOCALAPPDATA}\\Temp",
          "TMPDIR": "${env:LOCALAPPDATA}\\Temp"
        }
      },
      "group": "test",
      "isBackground": false,
      "problemMatcher": ["$tsc"]
    }
  ]
}
