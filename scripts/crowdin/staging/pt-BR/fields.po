msgctxt "lameta/person/customFields"
msgid "Custom Fields"
msgstr "Campos Personalizados"

msgctxt "lameta/person/customFields/tipOnUsingThisField"
msgid ""
"Use commas if you want multiple values. To remove a custom field, clear out "
"the value everywhere you have used it, then restart lameta."
msgstr ""
"Use vírgulas se você quiser valores múltiplos. Para remover um campo "
"personalizado, limpe o valor em todos os lugares onde você o utilizou e, em "
"seguida, reinicie lameta."

