{
  configurationFullName: "ELAR - Endangered Languages Archive",
  description: "Endangered Languages Archive",
  url: "https://www.elararchive.org/",
  archiveUsesImdi: true,
  // ELAR uses an extended IMDI schema that supports multilingual vocabulary fields
  // (Genre, SubGenre, Role with LanguageId attribute and unbounded occurrences)
  imdiSchema: "IMDI_3.0_elar.xsd",
  // ELAR does not want an IMDI or OPEX export that has known problems; warnings
  // are allowed
  exportFormatsBlockedByProblems: ["imdi", "opex-plus-files"],
  // lameta's checks that ELAR turns on or changes, over lameta's list in
  // ../lameta/settings.json5. The checks and their settings are listed in lameta's
  // src/problems/checkSettings.ts. ELAR's own checks, which are about the IMDI, are in
  // rules.js.
  checks: {
    // ELAR does not accept one language code written with different names in
    // different sessions
    languageNameVariations: { severity: "error" },
    // A session's files. MP3 is listed so that this check passes it; rules.js says
    // when ELAR accepts one.
    fileExtension: {
      severity: "error",
      mediaExtensions: ["wav", "mp4", "jpg", "jpeg", "png", "tif", "tiff", "mp3"],
      writtenExtensions: [
        "eaf",
        "csv",
        "pdf",
        "txt",
        "flextext",
        "fwbackup",
        "textgrid",
        "trs",
        "exb",
        "exs",
        "coma",
        "srt",
        "vtt",
        "apk",
        "exe",
      ],
    },
    fileNameLength: { severity: "error", maxLength: 20 },
    fileNameCharacters: { severity: "error", pattern: "^[A-Za-z0-9_-]*$" },
    // ELAR's validator asks neither of the consent session's files
    fileNameContainsSessionId: { severity: "error", exceptSessions: ["ConsentDocuments"] },
    fileNameDateStamp: {
      severity: "error",
      appliesTo: ["written"],
      exceptSessions: ["ConsentDocuments"],
    },
    fileSize: { severity: "error", limitsInGigabytes: [20, 30, 40, 50] },
    projectName: { severity: "error", pattern: "^[A-Za-z0-9-]*$", maxLength: 34 },
    sessionContributorsWithoutFullName: { severity: "error" },
    // From ELAR's metadata validator 2.0.9. ELAR's validator reports a genre that is
    // not in it as a warning.
    genreInList: {
      severity: "warning",
      genres: [
        "Academic output",
        "Anecdote",
        "Art",
        "Audiobook",
        "Autobiography",
        "Biography",
        "Brochure",
        "Catalog",
        "Chant",
        "Collection description",
        "Commentary",
        "Community materials",
        "Consent",
        "Conversation",
        "Dance",
        "Description",
        "Dialogue",
        "Dictionary",
        "Dissertation",
        "Drama",
        "Elicitation",
        "Ethnobiological description",
        "Ethnography",
        "Fable",
        "Fairy tale",
        "Field note",
        "Folk song",
        "Folktale",
        "Folklore",
        "Formulaic discourse",
        "Glossary",
        "Gossip",
        "Grammar",
        "History",
        "Hymn",
        "Incantation",
        "Instrumental music",
        "Interactive discourse",
        "Interview",
        "Joke",
        "Landscape description",
        "Language play",
        "Lecture",
        "Legend",
        "Letter",
        "Lexical database",
        "Ludic discourse",
        "Lullaby",
        "Manual",
        "Map",
        "Metadata",
        "Metadocumentation",
        "Monologue",
        "Music",
        "Myth",
        "Mythology",
        "Narrative",
        "Notebook",
        "Notes",
        "Novel",
        "Oral history",
        "Oral literature",
        "Oratory",
        "Orthography",
        "Personal narrative",
        "Photograph",
        "Poetry",
        "Poster",
        "Prayer",
        "Primer",
        "Procedural discourse",
        "Proverb",
        "Questionnaire",
        "Recipe",
        "Recitation",
        "Report",
        "Riddle",
        "Ritual",
        "Sand drawing",
        "Sermon",
        "Short story",
        "Singing",
        "Song",
        "Speech",
        "Stimuli",
        "Textbook",
        "Traditional game",
        "Translation",
        "Unintelligible speech",
        "Verbal art",
        "Video",
        "Word list",
      ],
    },
  },
}
