  <notes type="string">The title is the artist's own and must not be translated literally.</notes>
  <name type="string">Ásdís Mbeki</name>
  <birthYear type="string">1946</birthYear>
  <gender type="string">Male</gender>
  <primaryOccupation type="string">Conceptual artist; the best work is the absence of work</primaryOccupation>
  <ethnicGroup type="string">The Wet Paint School</ethnicGroup>
  <description type="string">Ásdís Mbeki belongs to Accidental Constructivism and works in Studio 4, the old soap factory. Asked about influences, Ásdís Mbeki said only &quot;a sculpture made entirely of hesitation&quot;.</description>
