<Person minimum_lameta_version_to_read="0.0.0">
  <notes type="string">Transcribe the pauses; the artist says they are the content.</notes>
  <name type="string">Alice Wong</name>
  <primaryOccupation type="string">Gallery cleaner and, by accident, prize-winning artist</primaryOccupation>
  <description type="string">Alice Wong belongs to Frameless Expressionism and works in the disused swimming pool. Asked about influences, Alice Wong said only &quot;silence, in three coats of varnish&quot;.</description>
